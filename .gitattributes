# The build writes LF and lint rejects CR, so keep the working tree LF on every platform.
* text=auto eol=lf
*.woff2 binary

# assets/tv/*.svg is generated by `node tv/build.mjs` from tv/content.mjs. Marking it generated collapses
# those fifteen files in diffs and pull requests (the real change is always in tv/), and keeps the repo's
# language statistics on the generator rather than on its output.
assets/tv/*.svg linguist-generated=true
